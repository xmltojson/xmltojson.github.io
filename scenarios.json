[
  {
    "name": "Scenario 1 Переклад UK to EN",
    "disabled": false,
    "steps": [
      {
        "type": "given",
        "text": "I open https://xmltojson.github.io/ShvydkoPereklad6.html",
        "disabled": false
      },
      {
        "type": "and",
        "text": "I click \"body > div.app > div.tabs > button:nth-child(1)\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "I choose \"uk\" from \"#srcLang\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "I choose \"en\" from \"#tgtLang\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "I type \"машина їде по дорозі\" into \"#srcText\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "I click \"#translateBtn\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "wait 1000",
        "disabled": false
      },
      {
        "type": "and",
        "text": "field \"#tgtText\" has value \"the car is driving on the road\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "I click \"body > div.app > div.tabs > button:nth-child(5)\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "field \"#historyList > div:nth-child(1) > div.history-meta > span:nth-child(1)\" has value \"UK → EN • general\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "field \"#historyList > div:nth-child(1) > div:nth-child(2) > strong\" has value \"машина їде по дорозі\"",
        "disabled": false
      },
      {
        "type": "and",
        "text": "field \"#historyList > div:nth-child(1) > div:nth-child(3)\" has value \"the car is driving on the road\"",
        "disabled": false
      }
    ]
  },
